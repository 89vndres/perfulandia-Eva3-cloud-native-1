# Copia este archivo a .env y cambia todos los secretos antes de usarlo.
JWT_SECRET=REEMPLAZA_POR_64_CARACTERES_ALEATORIOS_COMO_MINIMO
RABBITMQ_USERNAME=perfulandia
RABBITMQ_PASSWORD=CAMBIAR_PASSWORD_RABBITMQ
RABBITMQ_ERLANG_COOKIE=CAMBIAR_COOKIE_CLUSTER_RABBITMQ
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_PASSWORD_KEYCLOAK

# Keycloak IDaaS (realm importado desde infra/keycloak)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/perfulandia
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/perfulandia/protocol/openid-connect/certs

# Base de datos local por defecto. Para PostgreSQL cloud, sustituye estos valores:
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/NOMBRE_BD?sslmode=require
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=USUARIO_BD
# SPRING_DATASOURCE_PASSWORD=CLAVE_BD
# SPRING_JPA_DDL_AUTO=update
